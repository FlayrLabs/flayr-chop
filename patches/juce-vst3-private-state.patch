+/*
+  ==============================================================================
+
+   Flayr patch (not part of upstream JUCE). FLAYR_PATCH juce-vst3-private-state v2
+
+   The VST3 wrapper appends its own data to the plug-in's state:
+
+       [plug-in state] [int64 0] [private ValueTree] [int64 private size] "JUCEPrivateData"
+
+   Upstream trusted the 64-bit size from the project file (a size larger than the
+   data made the wrapper read far outside the buffer) and parsed the private data
+   with the recursive ValueTree::readFromData (a deeply nested tree overflowed the
+   stack), all before the plug-in's own setStateInformation could check anything.
+
+   split() checks the size against the data actually present; readBypass() reads the
+   only value the wrapper stores (the Bypass flag) from at most maxPrivateBytes with
+   no recursion. Header-only so fuzz targets can drive exactly the code the wrapper runs.
+
+  ==============================================================================
+*/
+
+#pragma once
+
+#include <juce_core/juce_core.h>
+
+#include <cstring>
+#include <optional>
+
+namespace juce::detail
+{
+
+struct VST3PrivateState
+{
+    static constexpr const char* identifier = "JUCEPrivateData";
+    static constexpr size_t maxPrivateBytes = 4096; // what JUCE writes is ~40 bytes
+
+    struct Split
+    {
+        bool valid = true;            // false: a malformed trailer, load nothing at all
+        size_t pluginStateSize = 0;   // bytes at the start that belong to the plug-in
+        const char* privateData = nullptr;
+        size_t privateSize = 0;
+    };
+
+    static Split split (const void* data, size_t size)
+    {
+        const auto idLen = std::strlen (identifier);
+        const auto* buffer = static_cast<const char*> (data);
+
+        if (buffer == nullptr || size < idLen + sizeof (uint64)
+            || std::memcmp (buffer + size - idLen, identifier, idLen) != 0)
+            return { true, size, nullptr, 0 }; // no trailer: everything is plug-in state
+
+        uint64 privateSize = 0;
+        std::memcpy (&privateSize, buffer + size - idLen - sizeof (uint64), sizeof (uint64));
+        privateSize = ByteOrder::swapIfBigEndian (privateSize);
+
+        // Bytes before the size field must hold the leading int64 and the private data.
+        const auto before = size - idLen - sizeof (uint64);
+
+        if (before < sizeof (uint64) || privateSize > before - sizeof (uint64))
+            return { false, 0, nullptr, 0 };
+
+        const auto privateBytes = (size_t) privateSize;
+        return { true, before - privateBytes - sizeof (uint64), buffer + before - privateBytes, privateBytes };
+    }
+
+    // The Bypass property of the private ValueTree, if present and well formed.
+    // Children are never read, so nesting can't recurse.
+    static std::optional<bool> readBypass (const char* data, size_t size)
+    {
+        if (data == nullptr || size == 0 || size > maxPrivateBytes)
+            return {};
+
+        MemoryInputStream in (data, size, false);
+
+        if (in.readString() != identifier)
+            return {};
+
+        const auto numProps = in.readCompressedInt();
+
+        if (numProps < 0 || numProps > 16)
+            return {};
+
+        std::optional<bool> result;
+
+        for (int i = 0; i < numProps; ++i)
+        {
+            const auto name = in.readString();
+            const auto numBytes = in.readCompressedInt();
+
+            if (numBytes <= 0 || numBytes > in.getNumBytesRemaining())
+                return {};
+
+            const auto start = in.getPosition();
+            const auto marker = in.readByte();
+
+            // var::writeToStream markers: 1 int (4 bytes follow), 2 true, 3 false.
+            if (name == "Bypass" && numBytes == 1 && (marker == 2 || marker == 3))
+                result = (marker == 2);
+            else if (name == "Bypass" && numBytes == 5 && marker == 1)
+                result = (in.readInt() != 0);
+
+            in.setPosition (start + numBytes);
+        }
+
+        return result;
+    }
+};
+
+} // namespace juce::detail
